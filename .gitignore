# Bun is the package manager (bun.lock is committed). Keep other lockfiles out.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Env / secrets
.env
.env.*
!.env.example

# Logs & OS
*.log
.DS_Store
Thumbs.db

# Local SQLite / Turso databases
*.db
*.db-journal
*.db-wal
local-control.db*
local-tenant*.db*

# Claude Code local settings
.claude/settings.local.json

# Design export: extracted runtime/fonts are regenerable (node docs/design/extract.mjs)
docs/design/source/assets/

# Playwright (tests/e2e): saved sign-in state, reports, traces
tests/e2e/.auth/
playwright-report/
test-results/

# Playwright MCP session output
.playwright-mcp/

# Scratch directory (temporary development prototypes & screenshots)
scratch/
