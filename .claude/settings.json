{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run *)",
      "Bash(bun install)",
      "Bash(bun install *)",
      "Bash(bun add *)",
      "Bash(bun pm ls*)",
      "Bash(bunx nuxi *)",
      "Bash(bunx vitest *)",
      "Bash(bunx eslint *)",
      "Bash(bunx supabase start)",
      "Bash(bunx supabase stop)",
      "Bash(bunx supabase status)",
      "Bash(bunx supabase migration new *)",
      "Bash(bunx supabase test db*)",
      "Bash(bunx supabase gen types *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "WebFetch(domain:ui.nuxt.com)",
      "WebFetch(domain:nuxt.com)",
      "WebFetch(domain:supabase.com)"
    ],
    "ask": [
      "Bash(bunx supabase db push*)",
      "Bash(bunx supabase link*)",
      "Bash(bunx supabase db reset*)",
      "Bash(npx supabase db push*)",
      "Bash(npx supabase link*)",
      "Bash(supabase db push*)",
      "Bash(supabase link*)",
      "Bash(vercel *)",
      "Bash(bunx vercel *)",
      "Bash(npx vercel *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-service-role.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.mjs\"",
            "timeout": 300,
            "statusMessage": "Typechecking changed files..."
          }
        ]
      }
    ]
  }
}
