# Tamago egg tracker: environment variables (docs/features/00-project-scaffold.md §3.9).
# Copy to `.env` (gitignored) and fill in the placeholders. Never commit real values.
# Local values come from `bunx supabase status` after `bun run db:start`.

# --- Public: exposed to the browser (runtimeConfig.public.supabase) ---
# Supabase API URL. Local stack: http://127.0.0.1:54321. Hosted: https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key ("Publishable" in `bunx supabase status`, starts with sb_publishable_),
# or the legacy anon key. Safe in the browser: RLS protects the data.
NUXT_PUBLIC_SUPABASE_KEY=<publishable key from `bunx supabase status`>

# --- Private: server-only (runtimeConfig.supabase.secretKey) ---
# Secret key ("Secret" in `bunx supabase status`, starts with sb_secret_), or the legacy
# service_role key. It bypasses RLS.
# Used ONLY by `bun run provision` (server/cli, runs on the operator's machine).
# The app does NOT use it at runtime in v1, so do NOT set it in Vercel. Never prefix it with NUXT_PUBLIC_.
NUXT_SUPABASE_SECRET_KEY=<secret key from `bunx supabase status`>

# Nothing else is required: pgTAP (`bun run test:db`) runs inside the local DB, and unit tests need no env.
