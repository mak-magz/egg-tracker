# Tamago egg tracker: environment variables (Firebase Auth + VueFire & Turso + Drizzle database-per-tenant).
# Copy to `.env` (gitignored) and fill in the placeholders. Never commit real values.

# --- Public: exposed to the browser (Firebase Web SDK / VueFire) ---
NUXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project-id>.appspot.com
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<messaging-sender-id>
NUXT_PUBLIC_FIREBASE_APP_ID=<firebase-app-id>

# --- Private: server-only (Firebase Admin SDK for session verification & provisioning) ---
# Either set GOOGLE_APPLICATION_CREDENTIALS to the path of your service-account.json file,
# or set FIREBASE_SERVICE_ACCOUNT to the raw JSON string of the service account.
# Never prefix these with NUXT_PUBLIC_.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT=

# --- Private: server-only (Turso Control DB & Tenant DB Provisioning) ---
# Local dev defaults to `file:local-control.db` and `file:local-tenant-<id>.db` when omitted.
# Production: `libsql://<control-db-name>-<org>.turso.io`
NUXT_TURSO_CONTROL_URL=file:local-control.db
NUXT_TURSO_CONTROL_AUTH_TOKEN=

# Optional: Turso Platform API credentials used by `bun run provision` to automatically create
# a dedicated Turso database per tenant (`libsql://tamago-<tenantId>-<org>.turso.io`).
# When omitted, `bun run provision` creates a local SQLite file (`file:local-tenant-<tenantId>.db`).
TURSO_API_TOKEN=
TURSO_ORG=
TURSO_GROUP=default
