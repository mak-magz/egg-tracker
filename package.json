{
  "name": "tamago-egg-tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:generate:control": "drizzle-kit generate --config=drizzle.control.config.ts",
    "db:generate:tenant": "drizzle-kit generate --config=drizzle.tenant.config.ts",
    "db:push:control": "drizzle-kit push --config=drizzle.control.config.ts",
    "db:push:tenant": "drizzle-kit push --config=drizzle.tenant.config.ts",
    "provision": "bun --env-file=.env server/cli/provision.ts",
    "emulator": "firebase emulators:start",
    "check:build": "node scripts/check-build-secrets.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.140",
    "@libsql/client": "^0.18.0",
    "@nuxt/ui": "^4.11.3",
    "@vueuse/core": "^14.4.0",
    "drizzle-orm": "^0.45.4",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "nuxt": "4.5.2",
    "nuxt-vuefire": "^1.1.2",
    "tailwindcss": "^4.3.3",
    "vuefire": "^3.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "source-map-js": "1.2.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@simple-git/argv-parser": "2.0.1",
    "shell-quote": "1.12.0",
    "esbuild": "0.28.2",
    "@nuxt/schema": "4.5.2"
  }
}