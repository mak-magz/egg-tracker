{
  "name": "tamago-egg-tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun run test:unit && bun run test:db",
    "test:unit": "vitest run",
    "test:db": "supabase test db",
    "test:migration": "node scripts/test-migration.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > shared/types/database.types.ts",
    "provision": "bun --env-file=.env server/cli/provision.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.136",
    "@nuxt/ui": "^4.11.2",
    "@nuxtjs/supabase": "^2.0.10",
    "@supabase/supabase-js": "^2.117.1",
    "@vueuse/core": "^14.4.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "bun@1.3.14"
}
