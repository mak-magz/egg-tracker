{
  "name": "tamago-egg-tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun run test:unit && bun run test:db",
    "test:unit": "vitest run",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:migration": "node scripts/test-migration.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > shared/types/database.types.ts",
    "provision": "bun --env-file=.env server/cli/provision.ts",
    "check:build": "node scripts/check-build-secrets.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.140",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/supabase": "^2.0.10",
    "@supabase/supabase-js": "^2.117.2",
    "@vueuse/core": "^14.4.0",
    "nuxt": "4.5.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "source-map-js": "1.2.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@simple-git/argv-parser": "2.0.1",
    "shell-quote": "1.12.0",
    "esbuild": "0.28.2",
    "@supabase/supabase-js": "2.117.2",
    "@nuxt/schema": "4.5.2"
  }
}
